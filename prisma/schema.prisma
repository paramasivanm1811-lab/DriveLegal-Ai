generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Law {
  id          String   @id @default(cuid())
  tier        String   // "state" | "local"
  district    String
  title       String
  desc        String
  authority   String
  penalty     String
  vehicleType String?
  category    String?  // "City" | "Highway" | "General"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
